{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-careflow"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagecareflow.dfs.core.windows.net/"
		},
		"LS_AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1001-081637-k32pg32z"
		},
		"LS_AzureKeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://careFlow-keyvault.vault.azure.net/"
		},
		"LS_AzureSQL_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "careflow-server.database.windows.net"
		},
		"LS_AzureSQL_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-careFlow"
		},
		"LS_AzureSQL_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "vishal"
		},
		"LS_PostgresSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-delicate-pine-b33ush1b-pooler.c-4.ap-southeast-1.aws.neon.tech"
		},
		"LS_PostgresSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgresSQL_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/PL_SOURCE_TO_SILVER_MAIN')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Read Source table List",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select table_id from ctrl.table_config WHERE is_active=1 and source_system='@{pipeline().parameters.source_system}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "AzureSqlTable1",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "Ingest All tables",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Read Source table List",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Read Source table List').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"activities": [
								{
									"name": "Ingest from Source to silver",
									"type": "ExecutePipeline",
									"dependsOn": [
										{
											"activity": "Inserts in progress status",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_SOURCE_to_SILVER_INNER",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"table_id": {
												"value": "@item().table_id",
												"type": "Expression"
											},
											"adf_run_id": {
												"value": "@pipeline().parameters.adf_run_id",
												"type": "Expression"
											}
										}
									}
								},
								{
									"name": "Inserts in progress status",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_AzureSQL_DB",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "INSERT INTO ctrl.audit_log(\nadf_run_id,\ntable_id,\nstage,\nstatus,\nstart_time)\nVALUES('@{pipeline().parameters.adf_run_id}',@{item().table_id},'SOURCE_to_SILVER','In_Progress', SYSUTCDATETIME())",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								},
								{
									"name": "update fail status",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "Ingest from Source to silver",
											"dependencyConditions": [
												"Failed"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_AzureSQL_DB",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "update ctrl.audit_log\nSET status = 'FAILED',\nend_time = SYSUTCDATETIME()\nwhere adf_run_id = '@{pipeline().parameters.adf_run_id}' and table_id = @{item().table_id}",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								},
								{
									"name": "Update pipeline as failed",
									"type": "Fail",
									"dependsOn": [
										{
											"activity": "Ingest from Source to silver",
											"dependencyConditions": [
												"Failed"
											]
										}
									],
									"userProperties": [],
									"typeProperties": {
										"message": "Inner Pipeline has been failed",
										"errorCode": "500"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"source_system": {
						"type": "string",
						"defaultValue": "adls_csv"
					},
					"adf_run_id": {
						"type": "string",
						"defaultValue": "a12"
					}
				},
				"variables": {
					"test": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable1')]",
				"[concat(variables('factoryId'), '/pipelines/PL_SOURCE_to_SILVER_INNER')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureSQL_DB')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_SOURCE_to_SILVER_INNER')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Read table details",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select * from ctrl.table_config where table_id = @{pipeline().parameters.table_id}",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "AzureSqlTable1",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": true
						}
					},
					{
						"name": "Set Start Time",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "start_time",
							"value": {
								"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Landing To Bronze",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Check source system",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/careFlow-repo/careFlow-adb-repo/from_landing_to_bronze",
							"baseParameters": {
								"table_name": {
									"value": "@activity('Read table details').output.firstRow.bronze_table_name",
									"type": "Expression"
								},
								"source_system": {
									"value": "@activity('Read table details').output.firstRow.source_system",
									"type": "Expression"
								},
								"landing_time": {
									"value": "@variables('start_time')",
									"type": "Expression"
								},
								"source_file_format": {
									"value": "@coalesce(activity('Read table details').output.firstRow.source_file_format,'')",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_AzureDatabricks1",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "bronze to silver",
						"type": "DatabricksNotebook",
						"dependsOn": [
							{
								"activity": "Landing To Bronze",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"notebookPath": "/careFlow-repo/careFlow-adb-repo/Bronze_to_Silver",
							"baseParameters": {
								"table_name": {
									"value": "@activity('Read table details').output.firstRow.silver_table_name\n",
									"type": "Expression"
								},
								"landing_time": {
									"value": "@variables('start_time')",
									"type": "Expression"
								},
								"merge_keys": {
									"value": "@coalesce(activity('Read table details').output.firstRow.merge_keys,'')",
									"type": "Expression"
								},
								"load_types": {
									"value": "@activity('Read table details').output.firstRow.load_type",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_AzureDatabricks1",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "update success status",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "bronze to silver",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "LS_AzureSQL_DB",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "update ctrl.audit_log\nSET status = 'SUCCESS',\nend_time = SYSUTCDATETIME(), records_written = @{activity('bronze to silver').output.runOutput}\nwhere adf_run_id = '@{pipeline().parameters.adf_run_id}' and table_id = @{pipeline().parameters.table_id}\n",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "Check types of load",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Read table details",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "Set Start Time",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(equals(activity('Read table details').output.firstRow.load_type,'FULL'))",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Read Watermark",
									"type": "Lookup",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "SELECT watermark_value from ctrl.watermark where table_id = @{pipeline().parameters.table_id}",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"dataset": {
											"referenceName": "AzureSqlTable1",
											"type": "DatasetReference",
											"parameters": {}
										}
									}
								},
								{
									"name": "Store watermark value",
									"type": "SetVariable",
									"dependsOn": [
										{
											"activity": "Read Watermark",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"variableName": "water_mark",
										"value": {
											"value": "@activity('Read Watermark').output.firstRow.watermark_value",
											"type": "Expression"
										}
									}
								}
							]
						}
					},
					{
						"name": "Check load type and update watermark",
						"description": "",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "bronze to silver",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(equals(activity('Read table details').output.firstRow.load_type,'FULL'))",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "update watermark",
									"type": "Script",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_AzureSQL_DB",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "update ctrl.watermark \n SET watermark_value = SYSUTCDATETIME()\n WHERE table_id = @{pipeline().parameters.table_id}",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					},
					{
						"name": "Check source system",
						"type": "Switch",
						"dependsOn": [
							{
								"activity": "Check types of load",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"on": {
								"value": "@activity('Read table details').output.firstRow.source_system",
								"type": "Expression"
							},
							"cases": [
								{
									"value": "neon_postgres",
									"activities": [
										{
											"name": "Source to Landing ingestion",
											"type": "Copy",
											"dependsOn": [],
											"policy": {
												"timeout": "0.12:00:00",
												"retry": 0,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"source": {
													"type": "PostgreSqlV2Source",
													"query": {
														"value": "SELECT * FROM PUBLIC.@{activity('Read table details').output.firstRow.source_table_name} \n@{\n    if(equals(activity('Read table details').output.firstRow.load_type, 'FULL') \n        ,'',\n        concat('WHERE ',activity('Read table details').output.firstRow.watermark_column, '>','''',variables('water_mark'),'''')\n)\n}",
														"type": "Expression"
													},
													"queryTimeout": "02:00:00"
												},
												"sink": {
													"type": "ParquetSink",
													"storeSettings": {
														"type": "AzureBlobFSWriteSettings"
													},
													"formatSettings": {
														"type": "ParquetWriteSettings"
													}
												},
												"enableStaging": false,
												"translator": {
													"type": "TabularTranslator",
													"typeConversion": true,
													"typeConversionSettings": {
														"allowDataTruncation": true,
														"treatBooleanAsNumber": false
													}
												}
											},
											"inputs": [
												{
													"referenceName": "DS_PostgreSql",
													"type": "DatasetReference",
													"parameters": {}
												}
											],
											"outputs": [
												{
													"referenceName": "DS_ADLS_Parquet",
													"type": "DatasetReference",
													"parameters": {
														"container": "landing",
														"folder": {
															"value": "@concat(\n    activity('Read table details').output.firstRow.source_system,\n    '/',activity('Read table details').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)",
															"type": "Expression"
														}
													}
												}
											]
										}
									]
								},
								{
									"value": "adls_csv",
									"activities": [
										{
											"name": "ingest CSV from source to landing",
											"type": "Copy",
											"dependsOn": [],
											"policy": {
												"timeout": "0.12:00:00",
												"retry": 0,
												"retryIntervalInSeconds": 30,
												"secureOutput": false,
												"secureInput": false
											},
											"userProperties": [],
											"typeProperties": {
												"source": {
													"type": "BinarySource",
													"storeSettings": {
														"type": "AzureBlobFSReadSettings",
														"recursive": false,
														"modifiedDatetimeStart": {
															"value": "@variables('water_mark')",
															"type": "Expression"
														},
														"deleteFilesAfterCompletion": false
													},
													"formatSettings": {
														"type": "BinaryReadSettings"
													}
												},
												"sink": {
													"type": "BinarySink",
													"storeSettings": {
														"type": "AzureBlobFSWriteSettings"
													}
												},
												"enableStaging": false
											},
											"inputs": [
												{
													"referenceName": "DS_CSV_Binary",
													"type": "DatasetReference",
													"parameters": {
														"folder": {
															"value": "@activity('Read table details').output.firstRow.source_path",
															"type": "Expression"
														},
														"container": "source"
													}
												}
											],
											"outputs": [
												{
													"referenceName": "DS_CSV_Binary",
													"type": "DatasetReference",
													"parameters": {
														"folder": {
															"value": "@concat(\n    activity('Read table details').output.firstRow.source_system,\n    '/',activity('Read table details').output.firstRow.source_table_name,\n    '/',\n    variables('start_time')\n)",
															"type": "Expression"
														},
														"container": "landing"
													}
												}
											]
										}
									]
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_id": {
						"type": "string",
						"defaultValue": "1"
					},
					"adf_run_id": {
						"type": "string",
						"defaultValue": "a2"
					}
				},
				"variables": {
					"start_time": {
						"type": "String"
					},
					"water_mark": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable1')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureDatabricks1')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_AzureSQL_DB')]",
				"[concat(variables('factoryId'), '/datasets/DS_PostgreSql')]",
				"[concat(variables('factoryId'), '/datasets/DS_ADLS_Parquet')]",
				"[concat(variables('factoryId'), '/datasets/DS_CSV_Binary')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/test')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Copy data1",
						"type": "Copy",
