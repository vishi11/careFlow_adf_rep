										}
									],
									"userProperties": [],
									"typeProperties": {
										"message": "GOLD notebook failed",
										"errorCode": "500"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
